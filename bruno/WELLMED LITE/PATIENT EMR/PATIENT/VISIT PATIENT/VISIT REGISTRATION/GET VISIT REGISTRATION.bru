meta {
  name: GET VISIT REGISTRATION
  type: http
  seq: 2
}

get {
  url: {{url}}/patient-emr/patient/:patient_id/visit-patient/:visit_patient_id/visit-registration
  body: none
  auth: bearer
}

params:query {
  ~search_value: 
}

params:path {
  patient_id: {{patient_id}}
  visit_patient_id: {{visit_patient_id}}
}

headers {
  appCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  bru.setVar('visit_registration_id',res.getBody().data.data[0].id)
}

settings {
  encodeUrl: true
}

docs {
  Gets information about the authenticated user.
}
