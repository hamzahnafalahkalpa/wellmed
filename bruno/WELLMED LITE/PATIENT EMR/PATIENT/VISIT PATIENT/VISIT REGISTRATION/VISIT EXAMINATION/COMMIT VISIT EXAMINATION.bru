meta {
  name: COMMIT VISIT EXAMINATION
  type: http
  seq: 5
}

put {
  url: {{url}}/patient-emr/patient/:patient_id/visit-patient/:visit_patient_id/visit-registration/:visit_registration_id/visit-examination/:visit_examination_id/examination/:type
  body: none
  auth: bearer
}

params:path {
  patient_id: {{patient_id}}
  visit_patient_id: {{visit_patient_id}}
  visit_registration_id: {{visit_registration_id}}
  visit_examination_id: {{visit_examination_id}}
  type: 
}

headers {
  appcode: 1
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
