meta {
  name: DELETE VISIT REGISTRATION
  type: http
  seq: 4
}

delete {
  url: {{url}}/patient-emr/patient/:patient_id/visit-patient/:visit_patient_id/visit-registration/:id
  body: none
  auth: bearer
}

params:query {
  ~search_value: 
}

params:path {
  patient_id: {{patient_id}}
  visit_patient_id: {{visit_patient_id}}
  id: {{visit_registration_id}}
}

headers {
  appCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  const timestamp = Date.now() / 1000;
  bru.setEnvVar("timestamp", timestamp);
  
  const appCode = req.getHeaders().get("AppCode")
  bru.setEnvVar("app_code", appCode);
}

script:post-response {
  bru.setVar('visit_registration_id',res.getBody().data.id)
}

settings {
  encodeUrl: true
}

docs {
  Gets information about the authenticated user.
}
