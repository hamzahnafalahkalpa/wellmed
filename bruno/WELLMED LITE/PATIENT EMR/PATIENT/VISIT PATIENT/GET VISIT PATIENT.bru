meta {
  name: GET VISIT PATIENT
  type: http
  seq: 2
}

get {
  url: {{url}}/patient-emr/patient/:patient_id/visit-patient
  body: none
  auth: bearer
}

params:path {
  patient_id: {{patient_id}}
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
