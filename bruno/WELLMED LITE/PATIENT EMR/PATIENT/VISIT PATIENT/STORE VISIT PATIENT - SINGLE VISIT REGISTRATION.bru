meta {
  name: STORE VISIT PATIENT - SINGLE VISIT REGISTRATION
  type: http
  seq: 4
}

post {
  url: {{url}}/patient-emr/patient/:patient_id/visit-patient
  body: json
  auth: bearer
}

params:path {
  patient_id: {{patient_id}}
}

headers {
  appCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "id" : null,
      "patient_id" : "{{patient_id}}", //GET FROM AUTOLIST - PATIENT PAGINATE
      "patient_type_service_id": "{{patient_type_service_id}}", //GET FROM AUTOLIST - PATIENT TYPE SERVICE LIST
      // "family_relationship": {
      //     "id": null,
      //     "family_role_id": "{{family_role_id}}", //require, GET FROM AUTOLIST - FAMILY ROLES LIST
      //     "name": "Toni Junior",
      //     "phone": "121215241521"
      // },
      "referral" : {
          "id": null,        
          "medic_service_id": null, //nullable, isi untuk internal referral
          "status" : "ACTIVE", //in: ACTIVE, DRAFT. Gunakan ACTIVE untuk rujukan dari luar ke dalam
          "referral_type" : "EXTERNAL", //required, in: INTERNAL,EXTERNAL
          "external_referral": { //nullable, isi untuk external referral
              "date"             : "2024-07-05",
              "doctor_name"      : "Dr. John Doe",
              "phone"            : "089692160031",
              "facility_name"    : "Klinik Harapan Sehat",
              "unit_name"        : "Poli Umum",
              "initial_diagnose" : null, //nullable, string
              "primary_diagnose" : null, //nullable string
              "note"             : "Pasien mengalami peradangan"
          }
          // "referral_code": null, //generated
          // "appointment_id": null
      },
      "visit_registration" : {
          "id" : null,
          "medic_service_id": "{{medic_service_id}}", //required, GET FROM AUTOLIST - MEDIC SERVICE LIST
          "practitioner_evaluation": { //nullable, FOR HEAD DOCTOR
              "id": null,
              // "practitioner_type" : "Employe", //nullable, default from config
              "practitioner_id": "{{employee_id}}", //GET FROM AUTOLIST - EMPLOYEE LIST (DOCTOR)
              "as_pic": true //nullable, default false, in:true/false
          },
          "visit_examination": { //required for rawat jalan
              "id": null,
              // "visit_patient_id": null,//required, akan di consume dari visit patient otomatis
              // "visit_registration_id": null,//required, akan di consume dari visit registration otomatis
              "practitioner_evaluations": [
                  {
                      "id": null,
                      "practitioner_type" : "Employee", //nullable, default from config
                      "practitioner_id": "{{employee_id}}" //GET FROM EMPLOYEE LIST
                  }
              ]
              // "examination" : {                    
              //     "treatments" : [
              //         {
              //             "id": null,
              //             "exam" : {
              //                 "treatment_id": "{{treatment_id}}", //required, GET FROM AUTOLIST - TREATMENT LIST BY POLI KLINIK/MEDIC SERVICE
              //                 "qty": 1//nullable, default:1
              //             }
              //         }
              //     ]
              //     // "screening_ids": [
              //     //     "{{screening_id}}" //GET FROM AUTOLIST - SCREENING LIST (MEDIC SERVICE)
              //     // ]
              // }
          }
      }
  }
}

script:post-response {
  let data = res.getBody();
  bru.setVar('visit_patient_id',data.data.id);
  bru.setVar('visit_registration_id',data.data.visit_registrations[0].id);
  bru.setVar('visit_examination_id',data.data.visit_registrations[0].visit_examination.id);
}

settings {
  encodeUrl: true
}
