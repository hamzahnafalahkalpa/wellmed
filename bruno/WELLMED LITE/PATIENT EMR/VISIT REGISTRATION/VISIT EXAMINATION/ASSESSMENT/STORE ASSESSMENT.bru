meta {
  name: STORE ASSESSMENT
  type: http
  seq: 1
}

post {
  url: {{url}}/patient-emr/visit-registration/:visit_registration_id/visit-examination/:visit_examination_id/assessment
  body: json
  auth: bearer
}

params:path {
  visit_registration_id: {{visit_registration_id}}
  visit_examination_id: {{visit_examination_id}}
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "id": null,
      // "parent_id": null,
      // "visit_registration_id": null,
      // "examination_summary_id": null,
      // "patient_summary_id": null,
      // "examination_type": null,
      // "examination_id": null,
      "exam": {
          "epiglotis": "Tidak edema, warna normal",
          "aritenoid": "Sedikit hiperemis, tidak ada massa",
          "plika_ventrikularis": "Simetris, tidak menonjol",
          "endoskopi": "Laring tampak jelas, tidak ditemukan lesi",
          "plika_vokalis": "Mobilitas baik, tidak edema",
          "rimaglotis": "Simetris saat fonasi"
      }
  }
}

settings {
  encodeUrl: true
}
