meta {
  name: SHOW ASSESSMENT
  type: http
  seq: 2
}

get {
  url: {{url}}/patient-emr/visit-registration/:visit_registration_id/visit-examination/:visit_examination_id/:morph/assessment
  body: none
  auth: bearer
}

params:path {
  visit_registration_id: {{visit_registration_id}}
  visit_examination_id: {{visit_examination_id}}
  morph: 
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
