meta {
  name: GET VISIT REGISTRATION LIST
  type: http
  seq: 2
}

get {
  url: {{url}}/patient-emr/visit-registration
  body: none
  auth: bearer
}

params:query {
  ~search_medic_service_label[0]: 
  ~search_status[0]: PROCESSING
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
