meta {
  name: SHOW VISIT REGISTRATION
  type: http
  seq: 3
}

get {
  url: {{url}}/patient-emr/visit-registration/:id
  body: none
  auth: bearer
}

params:path {
  id: {{visit_registration_id}}
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
