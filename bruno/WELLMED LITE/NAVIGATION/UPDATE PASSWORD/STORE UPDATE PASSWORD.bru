meta {
  name: STORE UPDATE PASSWORD
  type: http
  seq: 1
}

post {
  url: {{url}}/navigation/update-password
  body: json
  auth: bearer
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "old_password" : "12345678",
      "password" : "password",
      "password_confirmation" : "password"
  }
}

settings {
  encodeUrl: true
}
