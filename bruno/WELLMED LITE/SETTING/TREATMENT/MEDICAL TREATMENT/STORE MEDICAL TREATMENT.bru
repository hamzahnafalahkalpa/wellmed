meta {
  name: STORE MEDICAL TREATMENT
  type: http
  seq: 3
}

post {
  url: {{url}}/setting/treatment/medical-treatment
  body: json
  auth: bearer
}

headers {
  appcode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "id" : null,
      "name" : "Pemberian Vitamin Cs",
      "medical_service_treatments" : [
          {
              "id": null,
              //"medical_treatment_id": null, di consume dari medical treatment terluar
              "service_id" : "{{service_medic_service_id}}" //required, GET AUTOLIST - SERVICE LIST (MEDIC SERVICE)
          }
      ],
      "treatment" : {
          "id": null,
          //"name": "Pemberian Vitamin C" //akan di consume dari yang luar
          "service_label_id" : "{{service_label_id}}", //nullable, GET FORM AUTOLIST - SERVICE LABEL LIST
          "status": "ACTIVE", //require, in: ACTIVE, INACTIVE
          "service_prices": [
              {
                  "id": null,
                  //"service_id": ,required, di consume dari treatment id
                  //"service_item_type": "TariffComponent", //secara default TariffComponent, nullable
                  "service_item_id": "{{tariff_component_id}}", //required, GET FROM AUTOLIST - TARIFF COMPONENT LIST
                  "cogs": 10000,
                  "tax": 10,
                  "margin": 40
                  // "price": , //akan di hitung dari (calc_price = (cogs + cogs*margin/100)) + calc_price*tax/100
              }
          ]
      },
      "childs" : []
  }
}

script:post-response {
  let data = res.getBody()
  bru.setVar('medical_treatment_id',data.data.id)
  bru.setVar('treatment_id',data.data.treatment.id)
}

settings {
  encodeUrl: true
}
