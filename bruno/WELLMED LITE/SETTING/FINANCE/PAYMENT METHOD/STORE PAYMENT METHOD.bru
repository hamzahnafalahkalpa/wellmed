meta {
  name: STORE PAYMENT METHOD
  type: http
  seq: 2
}

post {
  url: {{url}}/setting/finance/payment-method
  body: json
  auth: bearer
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "id" : null,
      "name" : "Mandiri",
      "label" : "TUNAI" //TUNAI, NON TUNAI, BILLED
  }
}

script:post-response {
  bru.setVar("payment_method_id",res.getBody().data.id)
}

settings {
  encodeUrl: true
}
