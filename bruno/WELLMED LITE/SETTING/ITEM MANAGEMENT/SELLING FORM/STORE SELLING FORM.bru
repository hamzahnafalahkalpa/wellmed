meta {
  name: STORE SELLING FORM
  type: http
  seq: 2
}

post {
  url: {{url}}/setting/item-management/selling-form
  body: json
  auth: bearer
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "id" : null,
      "name" : "Blister 2"
  }
}

script:post-response {
  let data = res.getBody()
  bru.setVar('selling_form_id',data.data.id)
}

settings {
  encodeUrl: true
}
