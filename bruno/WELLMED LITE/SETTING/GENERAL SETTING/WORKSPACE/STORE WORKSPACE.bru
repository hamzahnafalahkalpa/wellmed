meta {
  name: STORE WORKSPACE
  type: http
  seq: 1
}

post {
  url: {{url}}/setting/general-setting/workspace
  body: json
  auth: bearer
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "uuid" : "{{workspace_uuid}}",
      "name" : "Klinik Pratama",
      "setting" : {
          "registration": {
              "is_examination": true,
              "examination": {
                  "subject" : true,
                  "object" : true,
                  "assessment" : true,
                  "planning" : true
              },
              "direct_pos": true
          },
          "email": "test@mail.com",
          "phone": "081906521808",
          "address": {
              "name" : "Sangkuriang",
              "province_id": null,
              "district_id": null,
              "subdistrict_id": null,
              "village_id": null,
              "latitude" : null,
              "longitude": null
          },
          "stakeholder": {
              "Kepala_Kesehatan_Lingkungan": "{{employee_id}}"
          }
      }
  }
}

settings {
  encodeUrl: true
}
