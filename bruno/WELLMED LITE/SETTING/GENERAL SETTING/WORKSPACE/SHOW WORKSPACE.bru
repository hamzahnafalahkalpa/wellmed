meta {
  name: SHOW WORKSPACE
  type: http
  seq: 2
}

get {
  url: {{url}}/setting/general-setting/workspace/:uuid
  body: none
  auth: bearer
}

params:path {
  uuid: {{workspace_uuid}}
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
