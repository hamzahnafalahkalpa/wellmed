meta {
  name: GENERATE TOKEN
  type: http
  seq: 1
}

post {
  url: {{urlsatusehat}}/token
  body: formUrlEncoded
  auth: bearer
}

headers {
  appcode: {{appcode}}
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  var data = res.getBody();
  bru.setVar("satu_sehat_token", data.api_resource.response.access_token);
}

settings {
  encodeUrl: true
}
