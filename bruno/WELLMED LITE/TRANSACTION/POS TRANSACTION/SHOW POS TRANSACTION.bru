meta {
  name: SHOW POS TRANSACTION
  type: http
  seq: 3
}

get {
  url: {{url}}/transaction/point-of-sale/:id
  body: none
  auth: bearer
}

params:path {
  id: {{transaction_id}}
}

headers {
  appcode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
