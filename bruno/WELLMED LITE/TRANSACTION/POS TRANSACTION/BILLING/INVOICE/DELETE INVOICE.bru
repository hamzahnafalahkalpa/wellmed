meta {
  name: DELETE INVOICE
  type: http
  seq: 4
}

delete {
  url: {{url}}/transaction/point-of-sale/:transaction_id/billing/:billing_id/invoice/:id
  body: none
  auth: bearer
}

params:path {
  transaction_id: {{transaction_id}}
  billing_id: {{billing_id}}
  id: {{invoice_id}}
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
