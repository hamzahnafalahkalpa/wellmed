meta {
  name: STORE BILLING
  type: http
  seq: 4
}

post {
  url: {{url}}/transaction/point-of-sale/:transaction_id/billing
  body: json
  auth: bearer
}

params:path {
  transaction_id: {{transaction_id}}
}

headers {
  appcode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "id": "{{billing_id}}",
      "reporting": true, //silakan tentukan kapan billing akan ditutup
      "invoices": [
          {
              "id" : null,                
              "payer_id": "{{consument_id}}", 
              "payer_type" : "Consument", 
              "reporting": true,
              "payment_history": {
                  "id": null,
                  "discount": 0,
                  "form": { //THIS FIELD USING ONLY FOR ARTIFICIAL DATA, WILL REMOVE WHEN DATA SETTLED
                      "payment_summaries": [
                          //YOU CAN USE PAYMENT SUMMARY AND PAYMENT DETAIL RESPONSE WHEN SHOW POS TRANSACTION
                          {
                              "id": "{{payment_summary_id}}",
                              "payment_details" : [
                                  {
                                      "id": "{{payment_detail_id}}"
                                  }
                              ]
                          }
                      ]
                  }
              },
              "split_payments": [
                  {
                      "id": null,
                      "money_paid": 100000, //nullable
                      "payment_method_id" : "{{payment_method_id}}" //required, GET FROM AUTOLIST - PAYMENT METHOD LIST                
                  }
              ]
          }
      ]
          // "deferred_payments": [
      //     {
      //         "id" : null,                
      //         "payer_id": "{{payer_id}}", //{{payer_id}}, GET AUTOLIST - PAYER LIST, default consument id dari transaction
      //         "payer_type" : "Company", //required, default: Consument/Company
      //         "reporting": true,
      //         "payment_summary": {
      //             "id": null,
      //             "discount": 0,
      //             "form": { //THIS FIELD USING ONLY FOR ARTIFICIAL DATA, WILL REMOVE WHEN DATA SETTLED
      //                 "payment_summaries": [
      //                     //YOU CAN USE PAYMENT SUMMARY AND PAYMENT DETAIL RESPONSE WHEN SHOW POS TRANSACTION
      //                     {
      //                         "id": "{{payment_summary_id}}",
      //                         "payment_details" : [
      //                             {
      //                                 "id": "{{payment_detail_id}}"
      //                             }
      //                         ]
      //                     }
      //                 ]
      //             }
      //         }
      //     }
      // ],
      // "author_type": "Employee", //WILL CONSUME FROM LOGIN
      // "author_id": "{{employee_id}}",//WILL CONSUME FROM LOGIN
      // "cashier_type": "Room", //LOGIN CURRENT ROOM 
      // "cashier_id": "{{room_id}}" //LOGIN CURRENT ROOM 
      // "has_transaction_id": null, //required without id
  }
}

script:post-response {
  let data = res.getBody();
  bru.setVar('billing_id',data.data.id);
}

settings {
  encodeUrl: true
}
