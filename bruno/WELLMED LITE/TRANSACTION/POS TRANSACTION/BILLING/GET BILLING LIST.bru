meta {
  name: GET BILLING LIST
  type: http
  seq: 2
}

get {
  url: {{url}}/transaction/point-of-sale/:transaction_id/billing
  body: none
  auth: bearer
}

params:path {
  transaction_id: {{transaction_id}}
}

headers {
  AppCode: {{appcode}}
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
