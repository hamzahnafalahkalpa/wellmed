meta {
  name: APPROVAL OPNAME
  type: http
  seq: 5
}

post {
  url: {{url}}/item-management/supply-chain/purchasing/:id/approval
  body: json
  auth: bearer
}

params:path {
  id: {{purchasing_id}}
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "type":"approval",
      "approval":true,
      "note":"pusing"
  }
}

settings {
  encodeUrl: true
}
