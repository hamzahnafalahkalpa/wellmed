              //     //         "unit_id": "{{composition_unit_id}}" //AUTOLIST - COMPOSITION UNIT LIST
              //     //     }
              //     // ]
              // }
          ]
      }
  }
}

script:post-response {
  bru.setVar('opname_stock_id',res.getBody().data.id)
}

settings {
  encodeUrl: true
}
