meta {
  name: DELETE EMPLOYEE
  type: http
  seq: 4
}

delete {
  url: {{url}}/employee-management/employee/:id
  body: none
  auth: bearer
}

params:path {
  id: {{employee_id}}
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
