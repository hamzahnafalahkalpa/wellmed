meta {
  name: STORE EMPLOYEE
  type: http
  seq: 3
}

post {
  url: {{url}}/employee-management/employee
  body: json
  auth: bearer
}

headers {
  appcode: {{appcode}}
  accept: application/json
}

auth:bearer {
